# Telegram Bot Token
TELEGRAM_BOT_TOKEN=

# Доступ только владельцу. Несколько Telegram ID указываются через запятую.
OWNER_TELEGRAM_IDS=

TEST_MODE=false
TEST_APIPOINT_SCENARIO=success

APIPOINT_API_URL=https://apipoint.ru/api/call
APIPOINT_TOKEN=
APIPOINT_CACHE_TTL_SECONDS=3600
APIPOINT_CONNECT_TIMEOUT=5
APIPOINT_READ_TIMEOUT=20
APIPOINT_HIGH_CONFIDENCE_OFFERS=8
APIPOINT_LIMITED_CONFIDENCE_OFFERS=3

YANDEX_AI_ENDPOINT=
YANDEX_AI_API_KEY=
YANDEX_VISION_MODEL_URI=gpt://<folder_id>/qwen3.6-35b-a3b
YANDEX_VISION_CONNECT_TIMEOUT=10
YANDEX_VISION_READ_TIMEOUT=90
YANDEX_VISION_MAX_RETRIES=1
YANDEX_VISION_PROMPT_VERSION=vehicle-condition-v1

MAX_PHOTOS_PER_ANALYSIS=20
MIN_PHOTOS_FOR_VISION=1
MAX_PHOTO_SIZE_BYTES=10485760
MAX_TOTAL_PHOTOS_SIZE_BYTES=52428800

# Настраиваемые финансовые допущения.
QUICK_SALE_COEFFICIENT=0.92
FIXED_EXPENSES_RUB=5000
RISK_RESERVE_RUB=10000
TARGET_PROFIT_RUB=40000
EXCELLENT_PRICE_MARGIN_RUB=10000

PARTS_SEARCH_MODE=MANUAL_BROWSER
DROM_BAZA_PERMISSION_CONFIRMED=false
DROM_BAZA_START_URL=https://baza.drom.ru/novosibirskaya-obl/sell_spare_parts/
PARTS_BROWSER_HEADLESS=true
PARTS_BROWSER_TIMEOUT_SECONDS=30
PARTS_BROWSER_MAX_OFFERS=20
PARTS_BROWSER_MAX_PAGES=1
PARTS_BROWSER_CONCURRENCY=1
PARTS_PRICE_CACHE_TTL_HOURS=12
PARTS_MIN_MATCHED_OFFERS=3
PARTS_MATCH_CONFIDENCE=0.80
PARTS_DEFAULT_CONDITION=NEW
YANDEX_PARTS_MODEL_URI=gpt://<folder_id>/qwen3.6-35b-a3b
YANDEX_PARTS_PROMPT_VERSION=parts-query-v1
YANDEX_PARTS_MATCH_PROMPT_VERSION=parts-match-v1
YANDEX_PARTS_MAX_RETRIES=1
