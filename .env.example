# Telegram Bot Token
TELEGRAM_BOT_TOKEN=

# Yandex Cloud
YANDEX_CLOUD_FOLDER_ID=
YANDEX_CLOUD_API_KEY=
# Альтернатива API key: OAuth-токен, который бот обменяет на IAM-токен.
YANDEX_CLOUD_OAUTH_TOKEN=
# OpenAI-совместимый Chat Completions endpoint Yandex Cloud.
YANDEXGPT_ENDPOINT=https://ai.api.cloud.yandex.net/v1/chat/completions

# База данных SQLite создается автоматически, настройки не нужны.
AUTO_RU_API_URL=
AUTO_RU_API_TOKEN=
