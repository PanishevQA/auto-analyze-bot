# Telegram Bot Token
TELEGRAM_BOT_TOKEN=

# Доступ только владельцу. Несколько Telegram ID указываются через запятую.
OWNER_TELEGRAM_IDS=

# APIpoint: реальные URL, путь к цене и авторизация задаются только по документации аккаунта.
APIPOINT_AVGCARPRICE_URL=
APIPOINT_AVGCARPRICE_PRICE_PATH=
APIPOINT_AVGCARPRICE_PARAM_MAP=
APIPOINT_CARPRICES_URL=
APIPOINT_CARPRICES_PRICE_PATH=
APIPOINT_CARPRICES_PARAM_MAP=
APIPOINT_AUTH_HEADER=
APIPOINT_AUTH_VALUE=
APIPOINT_CACHE_TTL_SECONDS=3600
APIPOINT_CONNECT_TIMEOUT=5
APIPOINT_READ_TIMEOUT=20

# Настраиваемые финансовые допущения.
QUICK_SALE_COEFFICIENT=0.92
FIXED_EXPENSES_RUB=5000
